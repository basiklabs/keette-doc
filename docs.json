{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Keette Developers",
  "colors": {
    "primary": "#061F00",
    "light": "#A5E119",
    "dark": "#061F00"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "family": "Uncut Sans",
    "source": "/fonts/UncutSans-Variable.woff2",
    "format": "woff2"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "api": {
    "mdx": {
      "server": "https://1178-41-90-137-132.ngrok-free.app/v1"
    },
    "playground": {
      "display": "interactive",
      "proxy": true
    },
    "examples": {
      "languages": ["curl", "node", "python", "go"],
      "defaults": "required",
      "prefill": true
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "icon": "rocket",
            "pages": ["index", "quickstart", "environments"]
          },
          {
            "group": "Auth",
            "icon": "key",
            "pages": ["auth/api-keys", "auth/overview"]
          },
          {
            "group": "Money",
            "icon": "coins",
            "pages": [
              "guides/fx",
              "guides/swaps",
              "guides/payins",
              "guides/payouts",
              "guides/balances",
              "guides/corridors",
              "guides/country-codes",
              "guides/money",
              "guides/relationships-and-purposes",
              "guides/transactions",
              "guides/beneficiaries"
            ]
          },
          {
            "group": "Errors",
            "icon": "ban",
            "pages": ["guides/errors"]
          },
          {
            "group": "Webhooks",
            "icon": "webhook",
            "pages": [
              "webhooks/overview",
              "webhooks/events",
              "webhooks/signatures",
              "webhooks/retries"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Overview",
            "pages": ["api-reference/introduction"]
          },
          {
            "group": "Account",
            "openapi": "openapi.yaml",
            "pages": ["GET /me"]
          },
          {
            "group": "Utilities",
            "openapi": "openapi.yaml",
            "pages": [
              "GET /banks",
              "GET /corridors",
              {
                "group": "Resolve",
                "pages": [
                  "GET /banks/ke",
                  "GET /banks/resolve",
                  "GET /banks/bic/{bic}"
                ]
              }
            ]
          },
          {
            "group": "Beneficiaries",
            "openapi": "openapi.yaml",
            "pages": [
              "GET /beneficiaries",
              "POST /beneficiaries",
              "GET /beneficiaries/{id}",
              "PATCH /beneficiaries/{id}",
              "POST /beneficiaries/{id}/archive"
            ]
          },
          {
            "group": "Balances",
            "openapi": "openapi.yaml",
            "pages": ["GET /balances"]
          },
          {
            "group": "FX",
            "openapi": "openapi.yaml",
            "pages": ["GET /fx/rate", "POST /fx/quotes"]
          },
          {
            "group": "Payouts",
            "openapi": "openapi.yaml",
            "pages": [
              "GET /payouts/purposes",
              "POST /payouts/fee",
              "POST /payouts",
              "GET /payouts/{id}",
              "POST /payouts/{id}/cancel"
            ]
          },
          {
            "group": "Swaps",
            "openapi": "openapi.yaml",
            "pages": ["POST /swaps", "GET /swaps/{id}"]
          },
          {
            "group": "Payins",
            "openapi": "openapi.yaml",
            "pages": [
              "GET /payins/sources",
              "POST /payins/fee",
              "POST /payins/preview",
              "POST /payins/prepare",
              "POST /payins",
              "GET /payins/{id}"
            ]
          },
          {
            "group": "Transactions",
            "openapi": "openapi.yaml",
            "pages": ["GET /transactions", "GET /transactions/{id}"]
          },
          {
            "group": "Webhooks",
            "openapi": "openapi.yaml",
            "pages": ["POST /ping", "GET /events", "GET /events/{id}"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Guides",
          "href": "/",
          "icon": "book-open"
        },
        {
          "anchor": "API reference",
          "href": "/api-reference/introduction",
          "icon": "code"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:talk@keette.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.keette.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/keette",
      "linkedin": "https://linkedin.com/company/keette"
    }
  }
}
